{
  "name": "hungelink-react",
  "private": true,
  "version": "1.0.0",
  "description": "HungeLink food redistribution application",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "native:sync": "npm run build && cap sync",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run build && cap run android",
    "ios:add": "cap add ios",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "npm run build && cap run ios",
    "windows:dev": "concurrently -k \"npm:dev -- --port 5000\" \"wait-on http://localhost:5000 && electron . --dev\"",
    "windows:run": "npm run build && electron .",
    "windows:build": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/ios": "^8.4.0",
    "@vitejs/plugin-react": "^5.1.1",
    "firebase": "^12.6.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.554.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-leaflet": "^5.0.0",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "concurrently": "^10.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.hungelink.app",
    "productName": "HungeLink",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/assets/images/hungelink_logo.png"
    }
  }
}
